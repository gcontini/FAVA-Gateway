# LLM provider that this proxy forwards to (credentials are set up in your harness)
LLM_PROXY_UPSTREAM_URL=https://api.openai.com/v1

# The extractor is a separate LLM that analyzes traffic for the permission graph.
# It can use the same provider, but must use separate credentials.
FAVA_EXTRACTOR_BASE_URL=https://api.openai.com/v1
FAVA_EXTRACTOR_MODEL=gpt-4o-mini
FAVA_EXTRACTOR_API_KEY=sk-your-api-key-here
